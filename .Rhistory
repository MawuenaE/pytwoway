cat(py$akm_summary)
library(data.table)
library(reticulate)
use_virtualenv("r-pytwoway", required = TRUE)
data <- fread("outputs/simulated_dads_long.csv")
py$data <- as.data.frame(data)
py_run_string("
import numpy as np
import pandas as pd
import bipartitepandas as bpd
import pytwoway as tw
# Convert R data to pandas DataFrame
df = data.copy()
# PyTwoWay expects columns like i, j, y, t
df = df.rename(columns={'year': 't'})
# Build BipartiteDataFrame
bdf = bpd.BipartiteDataFrame(df)
# Cleaning parameters
clean_params = bpd.clean_params({
'connectedness': 'leave_out_spell',
'collapse_at_connectedness_measure': True,
'drop_single_stayers': True,
'drop_returns': 'returners',
'copy': False
})
bdf_clean = bdf.clean(clean_params)
# FE / AKM parameters
fe_params = tw.fe_params({
'he': True,
'feonly': True,
'attach_fe_estimates': True,
'ncore': 1
})
fe_estimator = tw.FEEstimator(bdf_clean, fe_params)
fe_estimator.fit()
print(fe_estimator.summary)
# Save summary object as string for now
akm_summary = str(fe_estimator.summary)
")
library(reticulate)
use_virtualenv("r-pytwoway", required = TRUE)
