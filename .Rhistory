simulate_dads_2yr <- function(
n_workers = 20000,
n_firms = 1000,
p_move = 0.25,
sigma_alpha = 1,
sigma_psi = 0.5,
sigma_eps = 0.3,
seed = 123
) {
set.seed(seed)
workers <- data.table(
i = 0:(n_workers - 1),
alpha = rnorm(n_workers, mean = 0, sd = sigma_alpha)
)
firms <- data.table(
j = 0:(n_firms - 1),
psi = rnorm(n_firms, mean = 0, sd = sigma_psi)
)
workers[, j1 := sample(firms$j, .N, replace = TRUE)]
workers[, mover := runif(.N) < p_move]
workers[, j2 := j1]
movers_idx <- which(workers$mover)
for (idx in movers_idx) {
workers$j2[idx] <- sample(firms$j[firms$j != workers$j1[idx]], 1)
}
year1 <- workers[, .(
i,
j = j1,
year = 1L,
alpha,
mover
)]
year2 <- workers[, .(
i,
j = j2,
year = 2L,
alpha,
mover
)]
data <- rbind(year1, year2)
data <- merge(data, firms, by = "j", all.x = TRUE)
data[, lambda_t := 0.05 * (year == 2L)]
data[, eps := rnorm(.N, mean = 0, sd = sigma_eps)]
data[, y := alpha + psi + lambda_t + eps]
list(
data = data[, .(i, j, y, year)],
truth_workers = workers[, .(i, alpha, mover)],
truth_firms = firms[, .(j, psi)]
)
}
print(paste("Number of firms:", length(unique(sim$data$j))))
